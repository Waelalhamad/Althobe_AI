# Copy this file to .env and fill in the values. Never share or commit .env.

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# How much the AI "thinks" (billed). minimal = cheapest, low = default
OPENAI_REASONING_EFFORT=low

# --- Random secret that forms part of the webhook URLs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_TOKEN=

# --- WhatsApp (Cloud API + Coexistence). Provider: dualhook (default, $12/mo) or 360dialog ---
WHATSAPP_PROVIDER=dualhook
# Dualhook: connection Overview page -> API key (dh_live_...)
DUALHOOK_API_KEY=
# Phone Number ID of +90 531 670 87 09 (shown in the provider dashboard)
WA_PHONE_NUMBER_ID=
# Any random string; enter the same value as "verify token" when setting the webhook in Dualhook
WA_VERIFY_TOKEN=
# Only if WHATSAPP_PROVIDER=360dialog
D360_API_KEY=
# Hours the AI stays silent with a customer after the team replies from the phone app or after a handoff
HUMAN_PAUSE_HOURS=12

# --- Instagram + Messenger via Chatwoot ---
CHATWOOT_BASE_URL=https://app.chatwoot.com
# Settings -> Bots -> (your bot) -> access token
CHATWOOT_BOT_TOKEN=
# Optional: only if Chatwoot shows a signing secret for your bot/webhook
CHATWOOT_WEBHOOK_SECRET=

# --- Other ---
# "off" = listen-only: messages are stored but the AI never replies (use until knowledge/ is filled in)
AI_REPLIES=off

PORT=3000
DATABASE_PATH=data/agent.db
REPLY_DEBOUNCE_MS=4000
HISTORY_LIMIT=20
