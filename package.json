{
  "name": "althobe-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI customer support agent for WhatsApp, Instagram and Messenger via Chatwoot",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "chat": "tsx --env-file=.env scripts/chat.ts",
    "typecheck": "tsc --noEmit",
    "set-webhook": "tsx --env-file=.env scripts/set-webhook.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "openai": "^7.39.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
